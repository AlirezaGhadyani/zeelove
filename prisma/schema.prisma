datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventName   String
  aggregateId String
  payload     Json
  status      String    @default("PENDING")
  retries     Int       @default(0)
  occurredOn  DateTime
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  key       String   @id
  handler   String
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}

model User {
  id        String    @id @default(uuid())
  mobile    String    @unique
  name      String?
  role      String    @default("CUSTOMER")
  status    String    @default("ACTIVE")
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id              String   @id @default(uuid())
  mobile          String
  codeHash        String
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  expiresAt       DateTime
  resendAllowedAt DateTime
  createdAt       DateTime @default(now())

  @@index([mobile, createdAt])
  @@map("otp_challenges")
}

model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  altText      String?
  folder       String   @default("general")
  url          String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
  @@map("media")
}

