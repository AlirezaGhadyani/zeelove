# App
NODE_ENV=development
PORT=3000
APP_NAME=zeelove
APP_URL=http://localhost:3000

# Database & Cache (Self-hosted)
DATABASE_URL=postgresql://zeelove:zeelove_secret@localhost:5432/zeelove?schema=public
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Auth (OTP & Super Admin)
OTP_DEV_MODE=true
SEED_SUPER_ADMIN_MOBILE=09120000000
